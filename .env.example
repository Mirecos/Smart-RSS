# Smart RSS configuration.
# Copy to .env (the start scripts do it for you) and adjust. Every value is optional;
# the value shown is the default.

# ---------------------------------------------------------------------------
# Docker publishing
# ---------------------------------------------------------------------------

# Host interface and port the app is published on (http://<BIND_ADDRESS>:<PORT>).
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other devices on your network
# (logins then travel over plain HTTP: put a HTTPS reverse proxy in front for anything beyond a home LAN).
BIND_ADDRESS=127.0.0.1
PORT=8080

# Optional services to start with the app (comma-separated):
#   js    = headless-Chromium renderer, for sources with "Render JavaScript" (same as --js)
#   https = Caddy reverse proxy with automatic HTTPS certificates (production; see DOMAIN below)
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Production server (used with COMPOSE_PROFILES=https)
# ---------------------------------------------------------------------------

# Public domain name of the app, e.g. rss.example.com. Its DNS record must point to the server;
# Caddy then gets a Let's Encrypt certificate automatically. Also set TRUST_PROXY=true.
DOMAIN=

# Serve the app under a path of the domain instead of its root, e.g. /smart-rss for
# https://example.com/smart-rss/ (no trailing slash). Works with both proxy options and locally
# (http://localhost:8080/smart-rss/). Empty = served at the root.
BASE_PATH=

# Server that ALREADY runs lucaslorentz/caddy-docker-proxy as its main proxy: instead of the "https"
# profile, add the routing labels and join the proxy's Docker network with:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.caddy-docker-proxy.yml
# CADDY_NETWORK=caddy

# Docker image to run. Leave empty locally (the image is built from the sources);
# on the server the Deploy workflow sets it for you (ghcr.io/<owner>/<repo>:sha-...).
# APP_IMAGE=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# The first administrator, created at startup when the database has no user yet.
# Ignored once users exist: then manage users and passwords from the app ("Users" / "My account").
# Username: 3-50 letters, digits, ".", "_" or "-". Password: at least 8 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# How long a login stays valid (days). It is extended automatically while you use the app.
SESSION_TTL_DAYS=30

# Set to true only when a reverse proxy (doing HTTPS) sits in front of the app and sets
# X-Forwarded-* headers; the session cookie is then marked Secure.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Add a starter set of sources (news, tech, dev) the very first time the app starts
# with an empty database. They can also be added later from "Manage sources".
SEED_STARTER_SOURCES=true

# Extra browser origins allowed to call the API (comma-separated), e.g. when the app is served
# behind a reverse proxy under another host name: https://rss.example.lan
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Fetching
# ---------------------------------------------------------------------------

# Maximum response size in bytes (5 MB) and number of redirects followed.
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------

# Set to false to stop automatic refreshes (manual "Refresh" still works).
SCHEDULER_ENABLED=true
# How often due sources are checked, and how many are fetched in parallel (1 per host at a time).
SCHEDULER_TICK_SECONDS=60
SCHEDULER_CONCURRENCY=4
# A source is paused after this many failures in a row (editing or resuming it clears the pause).
MAX_CONSECUTIVE_FAILURES=10

# ---------------------------------------------------------------------------
# JavaScript renderer (profile "js")
# ---------------------------------------------------------------------------

# Token shared between the app and the renderer container. Change it to any random string.
RENDERER_TOKEN=change-me-local-renderer

# ---------------------------------------------------------------------------
# Local development only (npm run dev:server) - ignored by Docker, which sets these itself
# ---------------------------------------------------------------------------

# HOST=127.0.0.1
# DATA_DIR=./data
# WEB_DIST_DIR=apps/web/dist
# RENDERER_URL=ws://127.0.0.1:3000?token=change-me-local-renderer
