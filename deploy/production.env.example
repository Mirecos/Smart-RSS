# Production configuration template.
# Fill in the <...> values, then paste the WHOLE content into the GitHub secret "APP_ENV"
# (Settings > Environments > production > Environment secrets). The Deploy workflow writes it
# to the server as .env (mode 600) and appends APP_IMAGE itself.
# Every setting is explained in the root .env.example.

# --- Public access over HTTPS (Caddy + Let's Encrypt) --------------------------------------
COMPOSE_PROFILES=https
DOMAIN=<rss.example.com>
TRUST_PROXY=true
# The app itself stays private: only Caddy (ports 80/443) is exposed.
BIND_ADDRESS=127.0.0.1
PORT=8080

# --- First administrator (only used while the database has no user) ------------------------
ADMIN_USERNAME=<admin>
ADMIN_PASSWORD=<a long random password>
SESSION_TTL_DAYS=30

# --- Application ------------------------------------------------------------------------------
LOG_LEVEL=info
SEED_STARTER_SOURCES=true
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
SCHEDULER_CONCURRENCY=4
MAX_CONSECUTIVE_FAILURES=10
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
ALLOWED_ORIGINS=

# --- Optional JavaScript renderer: add "js" to COMPOSE_PROFILES (e.g. https,js) ---------------
RENDERER_TOKEN=<another long random string>
