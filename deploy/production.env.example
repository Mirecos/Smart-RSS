# Production configuration template.
# Fill in the <...> values, then paste the WHOLE content into the GitHub secret "APP_ENV"
# (Settings > Environments > production > Environment secrets). The Deploy workflow writes it
# to the server as .env (mode 600) and appends APP_IMAGE itself.
# Every setting is explained in the root .env.example.

# --- Public access over HTTPS: choose ONE option ----------------------------------------------
# Option A (default): the server already runs lucaslorentz/caddy-docker-proxy as its main proxy.
# The app gets "caddy" Docker labels and joins the proxy's network; the proxy handles HTTPS.
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.caddy-docker-proxy.yml
# The Docker network your caddy-docker-proxy container is attached to (docker network ls).
CADDY_NETWORK=caddy
COMPOSE_PROFILES=
#
# Option B: no proxy on the server yet -> use the built-in Caddy (it takes ports 80/443).
# Delete the three lines above and use instead:
# COMPOSE_PROFILES=https
#
DOMAIN=<rss.example.com>
# Served under DOMAIN/smart-rss. Leave empty to serve the app at the root of DOMAIN.
BASE_PATH=/smart-rss
TRUST_PROXY=true
# The app's own port stays private (localhost only): traffic comes through the proxy.
BIND_ADDRESS=127.0.0.1
PORT=8080

# --- First administrator (only used while the database has no user) ------------------------
ADMIN_USERNAME=<admin>
ADMIN_PASSWORD=<a long random password>
SESSION_TTL_DAYS=30

# --- Application ------------------------------------------------------------------------------
LOG_LEVEL=info
SEED_STARTER_SOURCES=true
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60
SCHEDULER_CONCURRENCY=4
MAX_CONSECUTIVE_FAILURES=10
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
ALLOWED_ORIGINS=

# --- Optional JavaScript renderer: add "js" to COMPOSE_PROFILES (e.g. js, or https,js) --------
RENDERER_TOKEN=<another long random string>
